# ══════════════════════════════════════════════════════
#  GAIA Agent — Environment Configuration
#  Copy this file to .env and fill in your values.
#  NEVER commit .env to version control.
# ══════════════════════════════════════════════════════

# ── LLM Provider ─────────────────────────────────────
# Choose: "gemini" or "openai"
LLM_PROVIDER=gemini

# Google Gemini (required if LLM_PROVIDER=gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# OpenAI-compatible (required if LLM_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# ── Web Search (optional but recommended) ────────────
# Choose: "tavily", "serper", or leave empty for DuckDuckGo (free)
SEARCH_PROVIDER=
SEARCH_API_KEY=

# Tavily (https://tavily.com) — recommended for best results
# SEARCH_PROVIDER=tavily
# SEARCH_API_KEY=your_tavily_api_key_here

# Serper (https://serper.dev) — Google results
# SEARCH_PROVIDER=serper
# SEARCH_API_KEY=your_serper_api_key_here

# ── Database ──────────────────────────────────────────
DATABASE_URL=sqlite:///./gaia.db

# ── Agent Behaviour ────────────────────────────────────
# Maximum reasoning steps before giving up
MAX_AGENT_STEPS=15

# ── File Uploads ──────────────────────────────────────
MAX_FILE_SIZE_MB=20

# ── Python Code Execution ─────────────────────────────
PYTHON_EXECUTION_TIMEOUT=10
